# Copie para .env (que o .gitignore ja ignora) e preencha.
#
# EXPO_PUBLIC_* sao as UNICAS que vao pro bundle do app -- o prefixo e o que
# autoriza o Expo a embutir. Nunca coloque a chave do Gemini nem a service_role
# aqui: tudo que o app web carrega e legivel no DevTools.
#
# No Vercel, cadastre estas duas em Settings > Environment Variables.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# --- Segredos da Edge Function -------------------------------------------
# NAO vao no .env do app. Cadastre no projeto Supabase com:
#   npx supabase secrets set GEMINI_API_KEY=...
#
# GEMINI_API_KEY   obrigatoria; gere em https://aistudio.google.com/apikey
# GEMINI_MODEL     opcional; o padrao e gemini-3.6-flash
